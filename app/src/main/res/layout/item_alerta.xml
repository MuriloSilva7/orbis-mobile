<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1.5dp"
    app:strokeColor="@color/border">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Imagem da máquina do alerta -->
        <ImageView
            android:id="@+id/imgAlerta"
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:minHeight="130dp"
            android:src="@drawable/ic_launcher_foreground"
            android:scaleType="centerCrop"
            android:background="@color/imageBackground"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true" />

        <!-- Conteúdo direito -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/imgAlerta"
            android:padding="14dp"
            android:paddingStart="16dp"
            android:gravity="center_vertical">

            <!-- Badge de status (ATIVO, EM_ANDAMENTO, etc) -->
            <TextView
                android:id="@+id/txtStatusVariavel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ATIVO"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/statusRed"
                android:background="@drawable/badge_outline_red"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginBottom="6dp" />

            <!-- Nome da Máquina -->
            <TextView
                android:id="@+id/txtNomeVariavel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome da Máquina"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="12dp" />

            <!-- Botão Ver Mais -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerMais"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Ver mais"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:backgroundTint="@color/purple"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>