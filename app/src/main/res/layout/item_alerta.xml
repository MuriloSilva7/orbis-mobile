<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    style="@style/ModernCard">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAlerta"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_launcher_foreground"
            android:scaleType="centerCrop"
            android:background="@color/lightGray"
            app:shapeAppearanceOverlay="@style/RoundedImageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintStart_toEndOf="@id/imgAlerta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Status -->
            <TextView
                android:id="@+id/txtStatusVariavel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ATIVO"
                style="@style/BadgeText"
                android:textColor="@color/statusRed"
                android:background="@drawable/badge_outline_red"
                android:layout_marginBottom="8dp" />

            <!-- Nome da Máquina -->
            <TextView
                android:id="@+id/txtNomeVariavel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome da Máquina"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="12dp" />

            <!-- Integridade -->
            <TextView
                android:id="@+id/txtIntegridadeAlerta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Integridade: --"
                android:textSize="12sp"
                android:textColor="@color/gray"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressIntegridadeAlerta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:progress="0"
                app:trackThickness="6dp"
                app:trackCornerRadius="3dp"
                app:indicatorColor="@color/statusGreen"
                app:trackColor="@color/lightGray" />

            <!-- Botão -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerMais"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/btn_ver_detalhes"
                android:textSize="12sp"
                android:textColor="@color/purple"
                app:cornerRadius="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>