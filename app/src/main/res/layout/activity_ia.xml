<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    tools:context=".ui.main.IaActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarIa"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            app:navigationIcon="@drawable/ic_voltar"
            app:navigationIconTint="@color/textPrimary"
            app:title=""
            app:titleTextColor="@android:color/transparent">

            <!-- Botão de Histórico agora na ESQUERDA (Start) -->
            <ImageButton
                android:id="@+id/btnHistoryIa"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_history_24"
                app:tint="@color/purple"
                android:contentDescription="Conversas Salvas" />

            <!-- Logo agora na DIREITA (End) -->
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:adjustViewBounds="true"
                android:src="@drawable/orbislogotoolbar"
                android:contentDescription="Orbis Logo" />

        </com.google.android.material.appbar.MaterialToolbar>

        <ProgressBar
            android:id="@+id/progressIa"
            style="@style/ModernProgressBar"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:visibility="gone" />

    </com.google.android.material.appbar.AppBarLayout>

    <View
        android:id="@+id/lineIa"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borderSoft"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout" />

    <!-- Mensagens do Chat -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutInputWrapper"
        app:layout_constraintTop_toBottomOf="@id/lineIa" />

    <!-- Área de Input Elevada -->
    <androidx.cardview.widget.CardView
        android:id="@+id/layoutInputWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/edtPergunta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Pergunte algo para o Orbi..."
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:textSize="15sp"
                android:textColor="@color/textPrimary" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnEnviar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:src="@drawable/ic_send_24"
                app:fabCustomSize="40dp"
                app:tint="@android:color/white"
                app:backgroundTint="@color/purple"
                app:elevation="0dp"
                android:contentDescription="Enviar" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>