<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.AlertaDetalheActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:logo="@drawable/orbislogotoolbar" />

    <View
        android:id="@+id/linha"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#808080"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/txtIdAlerta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ID do Alerta:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@id/linha"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtIdAlertaVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="alertaidvariavel"
        android:textSize="18sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/txtIdAlerta"
        app:layout_constraintBaseline_toBaselineOf="@id/txtIdAlerta" />


    <TextView
        android:id="@+id/txtIdSensor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ID do Sensor:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtIdAlerta"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtIdSensorVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="sensoridvariavel"
        android:textSize="18sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/txtIdSensor"
        app:layout_constraintBaseline_toBaselineOf="@id/txtIdSensor" />


    <TextView
        android:id="@+id/txtIdMaquina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ID da Máquina:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtIdSensor"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtIdMaquinaVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="maquinaidvariavel"
        android:textSize="18sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/txtIdMaquina"
        app:layout_constraintBaseline_toBaselineOf="@id/txtIdMaquina" />


    <TextView
        android:id="@+id/txtIdTecnico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ID do Técnico:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtIdMaquina"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtIdTecnicoVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="tecnicoidvariavel"
        android:textSize="18sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/txtIdTecnico"
        app:layout_constraintBaseline_toBaselineOf="@id/txtIdTecnico" />


    <TextView
        android:id="@+id/txtMaquina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Máquina:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtIdTecnico"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtMaquinaVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="maquinavariavel"
        android:textSize="18sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/txtMaquina"
        app:layout_constraintBaseline_toBaselineOf="@id/txtMaquina" />


    <TextView
        android:id="@+id/txtSensor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sensor:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtMaquina"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtSensorVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="sensorvariavel"
        android:textSize="18sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/txtSensor"
        app:layout_constraintBaseline_toBaselineOf="@id/txtSensor" />


    <TextView
        android:id="@+id/txtCriadoEm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Criado em:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtSensor"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtCriadoEmVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="criadoemvariavel"
        android:textSize="18sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/txtCriadoEm"
        app:layout_constraintBaseline_toBaselineOf="@id/txtCriadoEm" />


    <TextView
        android:id="@+id/txtTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tipo:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtCriadoEm"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtTipoVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="tipovariavel"
        android:textSize="18sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/txtTipo"
        app:layout_constraintBaseline_toBaselineOf="@id/txtTipo" />


    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtTipo"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtStatusVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="statusvariavel"
        android:textSize="18sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/txtStatus"
        app:layout_constraintBaseline_toBaselineOf="@id/txtStatus" />


    <TextView
        android:id="@+id/txtMensagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mensagem:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtStatus"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtMensagemVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="mensagemvariavel"
        android:textSize="18sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/txtMensagem"
        app:layout_constraintBaseline_toBaselineOf="@id/txtMensagem" />


    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:text="Voltar"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/darkGray"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtMensagem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnAceitar"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:text="Aceitar Alerta"
        android:backgroundTint="@color/darkGray"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnVoltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnConcluir"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:text="Concluir Alerta"
        android:backgroundTint="@color/darkGray"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnVoltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>