<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".ui.main.AlertaDetalheActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            android:elevation="0dp"
            app:logo="@drawable/orbislogotoolbar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/linha"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/border"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardAlertaDetalhe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/border"
            app:layout_constraintTop_toBottomOf="@id/linha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ID do Alerta -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/txtIdAlerta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ID do Alerta:" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/black" />
                    <TextView android:id="@+id/txtIdAlertaVariavel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="alertaidvariavel" android:textSize="15sp" android:textColor="@color/darkGray" android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- ID do Sensor -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/txtIdSensor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ID do Sensor:" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/black" />
                    <TextView android:id="@+id/txtIdSensorVariavel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="sensoridvariavel" android:textSize="15sp" android:textColor="@color/darkGray" android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- ID da Máquina -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/txtIdMaquina" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ID da Máquina:" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/black" />
                    <TextView android:id="@+id/txtIdMaquinaVariavel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="maquinaidvariavel" android:textSize="15sp" android:textColor="@color/darkGray" android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- ID do Técnico -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/txtIdTecnico" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ID do Técnico:" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/black" />
                    <TextView android:id="@+id/txtIdTecnicoVariavel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="tecnicoidvariavel" android:textSize="15sp" android:textColor="@color/darkGray" android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Máquina -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/txtMaquina" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Máquina:" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/black" />
                    <TextView android:id="@+id/txtMaquinaVariavel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="maquinavariavel" android:textSize="15sp" android:textColor="@color/darkGray" android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Sensor -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/txtSensor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sensor:" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/black" />
                    <TextView android:id="@+id/txtSensorVariavel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="sensorvariavel" android:textSize="15sp" android:textColor="@color/darkGray" android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Criado em -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/txtCriadoEm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Criado em:" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/black" />
                    <TextView android:id="@+id/txtCriadoEmVariavel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="criadoemvariavel" android:textSize="15sp" android:textColor="@color/darkGray" android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Tipo -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/txtTipo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tipo:" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/black" />
                    <TextView android:id="@+id/txtTipoVariavel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="tipovariavel" android:textSize="15sp" android:textColor="@color/darkGray" android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Status -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/txtStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status:" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/black" />
                    <TextView android:id="@+id/txtStatusVariavel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="statusvariavel" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/statusRed" android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Mensagem -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="20dp">
                    <TextView android:id="@+id/txtMensagem" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mensagem:" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/black" />
                    <TextView android:id="@+id/txtMensagemVariavel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="mensagemvariavel" android:textSize="15sp" android:textColor="@color/darkGray" android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Botões -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="4dp">

                    <Button
                        android:id="@+id/btnVerHistorico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ver Histórico de Manutenção"
                        android:textColor="@color/purple"
                        android:backgroundTint="@color/white"
                        app:strokeWidth="1.5dp"
                        app:strokeColor="@color/purple"
                        android:layout_marginBottom="8dp"
                        app:cornerRadius="12dp" />

                    <Button
                        android:id="@+id/btnCriarManutencao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Relatar Manutenção"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/purple"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp"
                        app:cornerRadius="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnVoltar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Voltar"
                            android:textColor="@color/darkGray"
                            android:backgroundTint="@color/white"
                            android:layout_marginEnd="10dp"
                            app:strokeWidth="1.5dp"
                            app:strokeColor="@color/border"
                            app:cornerRadius="12dp" />

                        <Button
                            android:id="@+id/btnAceitar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:text="Aceitar Alerta"
                            android:textColor="@color/white"
                            android:backgroundTint="@color/purple"
                            android:visibility="gone"
                            app:cornerRadius="12dp" />

                        <Button
                            android:id="@+id/btnConcluir"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:text="Concluir"
                            android:textColor="@color/white"
                            android:backgroundTint="@color/statusGreen"
                            android:visibility="gone"
                            app:cornerRadius="12dp" />

                        <Button
                            android:id="@+id/btnCancelar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:text="Cancelar"
                            android:textColor="@color/white"
                            android:backgroundTint="@color/statusRed"
                            android:visibility="gone"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>