<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    tools:context=".ui.fragments.AlertasFragment">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressAlertas"
        style="@style/ModernProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_alertas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_alertas"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:letterSpacing="-0.02"
        android:layout_marginStart="20dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/progressAlertas"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRefreshAlertas"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="12dp"
        app:icon="@drawable/ic_refresh"
        app:iconTint="@color/purple"
        android:contentDescription="@string/desc_recarregar"
        app:layout_constraintTop_toBottomOf="@id/progressAlertas"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textSubAlertas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sub_alertas"
        android:textSize="15sp"
        android:textColor="@color/textSecondary"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/text_alertas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchLayoutAlertas"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="20dp"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/textSecondary"
        app:endIconMode="clear_text"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxStrokeWidth="1dp"
        app:boxStrokeColor="@color/border"
        app:boxBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/textSubAlertas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editSearchAlertas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_hint_alertas"
            android:textSize="15sp"
            android:inputType="text"
            android:paddingVertical="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="16dp"
        app:tabTextColor="@color/textSecondary"
        app:tabSelectedTextColor="@color/purple"
        app:tabIndicatorColor="@color/purple"
        app:tabIndicatorHeight="2dp"
        app:tabIndicatorFullWidth="false"
        app:tabRippleColor="@android:color/transparent"
        app:tabMode="fixed"
        app:layout_constraintTop_toBottomOf="@id/searchLayoutAlertas" />

    <View
        android:id="@+id/tabLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borderSoft"
        app:layout_constraintTop_toBottomOf="@id/tabLayout" />

    <!-- ViewPager -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabLine"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>