<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    tools:context=".ui.main.SensorDetalheActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_surface"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_voltar"
            app:navigationIconTint="@color/textPrimary"
            app:title="">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:adjustViewBounds="true"
                android:src="@drawable/orbislogotoolbar"
                android:contentDescription="Orbis Logo" />

        </com.google.android.material.appbar.MaterialToolbar>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressSensor"
            style="@style/ModernProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSensor"
                style="@style/ModernCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:id="@+id/txtTipoVariavel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Tipo de Sensor"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:layout_marginEnd="16dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/txtEstadoVariavel"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/txtEstadoVariavel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ATIVO"
                            style="@style/BadgeText"
                            android:textColor="@color/statusGreen"
                            android:background="@drawable/badge_outline_green"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/txtTipoVariavel"
                            app:layout_constraintBottom_toBottomOf="@id/txtTipoVariavel" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Detalhes -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ID DO SENSOR" android:textColor="@color/gray" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.05" />
                    <TextView android:id="@+id/txtIdSensorVariavel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textSize="16sp" android:textColor="@color/black" android:layout_marginTop="4dp" android:layout_marginBottom="16dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ID DA MÁQUINA" android:textColor="@color/gray" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.05" />
                    <TextView android:id="@+id/txtIdMaquinaVariavel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textSize="16sp" android:textColor="@color/black" android:layout_marginTop="4dp" android:layout_marginBottom="24dp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" android:layout_marginBottom="24dp" />

                    <!-- Grid de Leituras -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ÚLT. TEMP." android:textColor="@color/gray" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.05" />
                            <TextView android:id="@+id/txtUltimaTemperaturaVariavel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:layout_marginTop="4dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIMITE" android:textColor="@color/gray" android:textSize="10sp" android:layout_marginTop="8dp" />
                            <TextView android:id="@+id/txtLimiteTemperaturaVariavel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textSize="14sp" android:textColor="@color/darkGray" />
                        </LinearLayout>

                        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/border" android:layout_marginHorizontal="16dp" />

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ÚLT. VIBR." android:textColor="@color/gray" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.05" />
                            <TextView android:id="@+id/txtUltimaVibracaoVariavel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" android:layout_marginTop="4dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIMITE" android:textColor="@color/gray" android:textSize="10sp" android:layout_marginTop="8dp" />
                            <TextView android:id="@+id/txtLimiteVibracaoVariavel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--" android:textSize="14sp" android:textColor="@color/darkGray" />
                        </LinearLayout>

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" android:layout_marginTop="24dp" android:layout_marginBottom="24dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button android:id="@+id/btnVoltar" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>