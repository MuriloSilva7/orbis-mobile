<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:logo="@drawable/orbislogotoolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


    </com.google.android.material.appbar.MaterialToolbar>

    <View
        android:id="@+id/linha"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#808080"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>



    <TextView
        android:id="@+id/txtIdSensor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linha"
        android:text="ID do Sensor: "
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        android:layout_marginStart="50dp"/>


    <TextView
        android:id="@+id/txtIdSensorVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ID do sensor"
        android:textSize="18sp"
        app:layout_constraintStart_toEndOf="@+id/txtIdSensor"
        app:layout_constraintTop_toBottomOf="@+id/linha"
        android:layout_marginTop="40dp"/>

    <TextView
        android:id="@+id/txtIdMaquina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtIdSensor"
        android:text="ID da Máquina: "
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginStart="50dp"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtIdMaquinaVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ID da Máquina"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/txtIdSensor"
        app:layout_constraintStart_toEndOf="@+id/txtIdMaquina"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtIdMaquina"
        android:text="Tipo: "
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginStart="50dp"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtTipoVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome do Tipo"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/txtIdMaquina"
        app:layout_constraintStart_toEndOf="@+id/txtTipo"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtUltimaTemperatura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtTipo"
        android:text="Última Temperatura: "
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginStart="50dp"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtUltimaTemperaturaVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ultima temperatura"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/txtTipo"
        app:layout_constraintStart_toEndOf="@+id/txtUltimaTemperatura"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtLimiteTemperatura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtUltimaTemperatura"
        android:text="Limite de Temperatura: "
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginStart="50dp"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtLimiteTemperaturaVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Limite"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/txtUltimaTemperatura"
        app:layout_constraintStart_toEndOf="@+id/txtLimiteTemperatura"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtUltimaVibracao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtLimiteTemperatura"
        android:text="Última Vibração: "
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginStart="50dp"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtUltimaVibracaoVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vibração"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/txtLimiteTemperatura"
        app:layout_constraintStart_toEndOf="@+id/txtUltimaVibracao"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtLimiteVibracao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtUltimaVibracao"
        android:text="Limite de Vibração: "
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginStart="50dp"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtLimiteVibracaoVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Limite"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/txtUltimaVibracao"
        app:layout_constraintStart_toEndOf="@+id/txtLimiteVibracao"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtLimiteVibracao"
        android:text="Estado: "
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginStart="50dp"
        android:layout_marginTop="9dp"/>



    <TextView
        android:id="@+id/txtEstadoVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ativo ou não"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/txtLimiteVibracao"
        app:layout_constraintStart_toEndOf="@+id/txtEstado"
        android:layout_marginTop="9dp"/>

    <Button
        android:id="@+id/btnVoltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtEstado"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Voltar"
        android:layout_gravity="end"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/darkGray"/>

</androidx.constraintlayout.widget.ConstraintLayout>