<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    style="@style/ModernCard">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgSensorIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_launcher_foreground"
            app:tint="@color/purple"
            android:background="@drawable/circle_purple_bg"
            android:padding="8dp"
            android:backgroundTint="#145E17EB"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/imgSensorIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/txtBadgeTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_sensor"
                style="@style/BadgeText"
                android:textColor="@color/purple"
                android:background="@drawable/badge_outline_purple"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txtTipoVariavel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do Sensor"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:letterSpacing="-0.01"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerMais"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/btn_ver_detalhes"
                android:textSize="12sp"
                android:textColor="@color/purple"
                app:cornerRadius="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
