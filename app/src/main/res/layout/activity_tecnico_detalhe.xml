<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".ui.main.TecnicoDetalheActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            android:elevation="0dp"
            app:logo="@drawable/orbislogotoolbar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/linha"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/border"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardTecnicoDetalhe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/border"
            app:layout_constraintTop_toBottomOf="@id/linha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <!-- Avatar -->
                <ImageView
                    android:id="@+id/imgTecnico"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/ic_launcher_foreground"
                    android:scaleType="centerCrop"
                    android:background="@drawable/circle_purple_bg"
                    android:layout_marginBottom="12dp" />

                <!-- Cargo -->
                <TextView
                    android:id="@+id/txtCargoVariavel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargo"
                    android:textSize="14sp"
                    android:textColor="@color/purple"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/badge_outline_purple"
                    android:layout_marginBottom="8dp" />

                <!-- Nome -->
                <TextView
                    android:id="@+id/txtNomeVariavel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- Especialidade -->
                <TextView
                    android:id="@+id/txtEspecialidadeVariavel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Especialidade"
                    android:textSize="14sp"
                    android:textColor="@color/darkGray"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:background="@drawable/badge_outline_gray"
                    android:layout_marginBottom="8dp" />

                <!-- Estado / Disponibilidade -->
                <TextView
                    android:id="@+id/txtEstadoVariavel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ativo ou não"
                    android:textSize="14sp"
                    android:textColor="@color/statusGreen"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/badge_outline_green"
                    android:layout_marginBottom="8dp" />

                <!-- Telefone -->
                <TextView
                    android:id="@+id/txtTelefoneVariavel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Telefone"
                    android:textSize="14sp"
                    android:textColor="@color/darkGray"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:background="@drawable/badge_outline_gray"
                    android:layout_marginBottom="8dp" />

                <!-- Email -->
                <TextView
                    android:id="@+id/txtEmailVariavel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textSize="14sp"
                    android:textColor="@color/darkGray"
                    android:gravity="center"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp"
                    android:background="@drawable/badge_outline_gray"
                    android:layout_marginBottom="20dp" />

                <!-- Botão Voltar -->
                <Button
                    android:id="@+id/btnVoltar"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:text="Voltar"
                    android:textColor="@color/darkGray"
                    android:backgroundTint="@color/white"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/border"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
