<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.TecnicoDetalheActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:logo="@drawable/orbislogotoolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


    </com.google.android.material.appbar.MaterialToolbar>

    <View
        android:id="@+id/linha"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#808080"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/imgTecnico"
        android:layout_width="200dp"
        android:layout_height="180dp"
        android:src="@drawable/ic_launcher_foreground"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linha"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/txtCargoVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cargo"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/imgTecnico"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        />

    <TextView
        android:id="@+id/txtNomeVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/txtCargoVariavel"
        android:text="Nome"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="9dp"
        />


    <TextView
        android:id="@+id/txtEspecialidadeVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Especialidade"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/txtNomeVariavel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtEstadoVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ativo ou não"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/txtEspecialidadeVariavel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtTelefoneVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Telefone"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/txtEstadoVariavel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="9dp"/>

    <TextView
        android:id="@+id/txtEmailVariavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@+id/txtTelefoneVariavel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="9dp"/>

    <Button
        android:id="@+id/btnVoltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtEmailVariavel"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Voltar"
        android:layout_gravity="end"
        app:cornerRadius="12dp"
        android:backgroundTint="@color/darkGray"/>

</androidx.constraintlayout.widget.ConstraintLayout>